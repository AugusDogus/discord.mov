{
  "name": "discord.mov",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "start": "bun index.ts",
    "start:node": "node --env-file=.env --import=tsx index.ts",
    "lint": "oxlint",
